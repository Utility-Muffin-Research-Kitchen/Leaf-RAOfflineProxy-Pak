#!/bin/sh
set -eu

PAK_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
PLATFORM=${PLATFORM:-mlp1}

if [ -n "${UMRK_ENV_FILE:-}" ] && [ -f "$UMRK_ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$UMRK_ENV_FILE"
elif [ -n "${SDCARD_PATH:-}" ] &&
     [ -f "$SDCARD_PATH/.system/leaf/platforms/$PLATFORM/launcher/env.sh" ]; then
    # shellcheck disable=SC1090
    . "$SDCARD_PATH/.system/leaf/platforms/$PLATFORM/launcher/env.sh"
fi

SDCARD_PATH=${SDCARD_PATH:-/mnt/sdcard}
USERDATA_PATH=${USERDATA_PATH:-$SDCARD_PATH/.userdata/$PLATFORM}
RAOFFLINEPROXY_CONFIG_DIR=${RAOFFLINEPROXY_CONFIG_DIR:-$USERDATA_PATH/RAOfflineProxy}
PYTHONHOME=$PAK_DIR/runtime
PYTHONPATH=$PAK_DIR/app
SSL_CERT_FILE=$PAK_DIR/runtime/ca-certificates.crt
LD_LIBRARY_PATH=$PAK_DIR/runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export SDCARD_PATH USERDATA_PATH RAOFFLINEPROXY_CONFIG_DIR PYTHONHOME PYTHONPATH
export SSL_CERT_FILE LD_LIBRARY_PATH

. "$PAK_DIR/lib/leaf-version-gate.sh"
gate_status=0
leaf_version_gate_manifest "$PAK_DIR/pak.json" \
    "$SDCARD_PATH/.umrk/$PLATFORM/release.json" || gate_status=$?
if [ "$gate_status" -ne 0 ]; then
    echo "RAOfflineProxy: refusing to start: ${LEAF_VERSION_GATE_REASON:-unknown}" >&2
    echo "RAOfflineProxy: Leaf installed=${LEAF_INSTALLED_VERSION:-Unknown} required=${LEAF_REQUIRED_VERSION:-Unknown}" >&2
    echo "RAOfflineProxy: Jawaka installed=${JAWAKA_INSTALLED_VERSION:-Unknown} required=${JAWAKA_REQUIRED_VERSION:-Unknown}" >&2
    exit 64
fi

exec "$PYTHONHOME/bin/python3" -m raofflineproxy.leaf_service
