+    def _quarantine_corrupt_sqlite(self, reason: str) -> Path:
+        quarantine_path = self._database_path.with_name(
+            f"{self._database_path.name}.corrupt-{current_millis()}"
+        )
+        try:
+            size_bytes = self._database_path.stat().st_size
+            self._database_path.replace(quarantine_path)
+        except OSError as exc:
+            LOGGER.error(
+                "Failed to quarantine corrupt database %s: %s",
+                self._database_path,
+                exc,
+            )
+            return self._database_path
+        storage_corruption.record_incident(
+            quarantine_path, reason, size_bytes, None
+        )
+        return quarantine_path
