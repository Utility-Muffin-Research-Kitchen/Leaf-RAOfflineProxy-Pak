+    def pending_award_account_mismatch(
+        self, path: str, raw_body: str
+    ) -> str | None:
+        """Leaf: durable state is single-account while awards are pending.
+        Another user may use their own cached game data, but their awards
+        cannot join the first user's hash chain or flush with its token.
+        """
+        incoming_user = (extract_request_param(path, raw_body, "u") or "").lower()
+        if not incoming_user:
+            return None
+        with self.pending_award_lock:
+            # Only rows still awaiting a flush constrain the account.
+            # get_pending_awards() returns the whole table, including the
+            # flushed/stale/deleted rows that survive until the post-flush
+            # sweep clears them; blocking a second user on those would outlast
+            # the reason for blocking them.
+            owners = {
+                user
+                for user in (
+                    award_username(award)
+                    for award in self.storage.get_pending_awards()
+                    if award.get("status", PENDING_AWARD_STATUS_PENDING)
+                    == PENDING_AWARD_STATUS_PENDING
+                )
+                if user
+            }
+        if owners and incoming_user not in owners:
+            return (
+                "account_mismatch: pending awards belong to "
+                + ", ".join(sorted(owners))
+                + "; they must flush under their own account first"
             )
+        return None
 
