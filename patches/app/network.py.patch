--- a/linux/raofflineproxy/network.py
+++ b/linux/raofflineproxy/network.py
@@ -17,6 +17,9 @@
 
 LOGGER = logging.getLogger("raofflineproxy")
 REDACTED_QUERY_KEYS = {"p", "t", "token", "password"}
+# Leaf: the reachability probe runs on the RetroArch request path, so it is
+# capped at 500 ms (R0 bound; a dead/captive network must not stall play).
+REACHABILITY_PROBE_TIMEOUT_SECONDS = 0.5
 REACHABILITY_INTERVAL_SECONDS = 30.0
 PROBE_ATTEMPTS = 3
 PROBE_RETRY_DELAY_SECONDS = 1.0
@@ -180,8 +183,8 @@
     reachable, checked_at = _reachability_tracker.current()
     if checked_at == 0.0:
         return True
-    if not reachable:
-        return True
+    # Leaf: failed probes are cached too. A dead network must not cost the
+    # probe timeout again before every RetroArch request.
     return (current_time - checked_at) >= REACHABILITY_INTERVAL_SECONDS
 
 
@@ -262,7 +265,9 @@
     )
     try:
         with urllib.request.urlopen(
-            request, timeout=5, context=configured_ssl_context()
+            request,
+            timeout=REACHABILITY_PROBE_TIMEOUT_SECONDS,
+            context=configured_ssl_context(),
         ) as response:
             if 200 <= response.status < 500:
                 return True, ""
