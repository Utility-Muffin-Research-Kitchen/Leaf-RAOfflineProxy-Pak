+def award_username(award: dict) -> str | None:
+    """The RetroAchievements username an award's request body belongs to."""
+    user = extract_form_param(award.get("requestBody", ""), "u")
+    return user.lower() if user else None
+
+
+def resolve_leaf_credentials(
+    storage: Storage, pending: list[dict]
+) -> tuple[dict | None, str | None]:
+    """Leaf: flushes use only per-user tokens learned from proxied RetroArch
+    traffic. The pak never reads RetroArch configuration, so upstream's
+    auth.py credential ladder (RetroArch cfg scan, password re-login) is
+    removed with auth.py itself.
+
+    Durable state is single-account while awards are pending: if any pending
+    award belongs to a different user than the cached login, the flush defers
+    until that account's awards are gone rather than cross-substituting a
+    newer user's token.
+    """
+    credentials = storage.load_login_credentials()
+    if credentials is None:
+        return None, "no cached RetroAchievements token (play online once first)"
+    cached_user = str(credentials.get("user", "")).lower()
+    pending_users = {
+        user for user in (award_username(award) for award in pending) if user
+    }
+    if pending_users and cached_user not in pending_users:
+        owners = ", ".join(sorted(pending_users))
+        return None, (
+            f"account_mismatch: pending awards belong to {owners};"
+            " they must flush under their own account"
+        )
+    if len(pending_users) > 1:
+        owners = ", ".join(sorted(pending_users))
+        return None, f"account_mismatch: pending awards span multiple users ({owners})"
+    return credentials, None
+
+
